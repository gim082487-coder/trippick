# 트립픽 — Cloudflare Pages 정적 자원 캐시 정책 (v22)
# ------------------------------------------------------------------
# Cloudflare Pages 는 위에서부터 "처음 매칭된 규칙"의 헤더를 씁니다.
# 그래서 구체 경로(/images/*, /assets/*)를 위에, 전체 규칙(/*)을 맨 아래에 둡니다.
# 수정 뒤에는 `python3 build_pages.py --out ../deploy_site --check-links` 로
# deploy_site/_headers 에 그대로 복사됩니다.

# 1) 이미지 — 7일 (사진·상품 썸네일은 잘 바뀌지 않음)
/images/*
  Cache-Control: public, max-age=604800

/assets/ess/*
  Cache-Control: public, max-age=604800

# 2) CSS·JS — 1일 (site.css 는 ?v= 버전 쿼리로 갱신)
/assets/*
  Cache-Control: public, max-age=86400

# 3) 루트에 바로 놓인 이미지 확장자 (혹시 /images 밖에 있을 때)
/*.jpg
  Cache-Control: public, max-age=604800

/*.jpeg
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

/*.webp
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

# 4) 색인·광고 확인용 파일은 항상 최신
/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=0, must-revalidate

/ads.txt
  Cache-Control: public, max-age=0, must-revalidate

# 5) HTML 은 항상 재검증 (배포 즉시 반영)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
